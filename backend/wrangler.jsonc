{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "myx-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-09",
  "compatibility_flags": ["nodejs_compat"],
  // Daily at 03:15 UTC: sweep spent reset tokens and log D1 usage against the
  // free-tier ceiling. See src/lib/usage.ts.
  "triggers": { "crons": ["15 3 * * *"] },

  "observability": {
    "enabled": true
  },
  /*
    The API's own hostname. Declared here rather than left in the dashboard so a
    fresh deploy from a clean checkout reproduces the whole setup.

    Deliberately one level deep. api.myx.samchitech.com was tried first and had
    no certificate: Cloudflare's Universal SSL covers samchitech.com and
    *.samchitech.com, and a two-level name falls outside that wildcard, so the
    edge answered every request with a TLS handshake failure. This name is
    inside the wildcard and worked the moment it was added.

    workers_dev is set explicitly and must stay that way. Declaring "routes"
    flips its default to false, which silently took myx-api.samchitech.workers.dev
    offline the moment this block was added — a 404 for every request from the
    then-deployed frontend, which was still calling that hostname, and for any
    MCP client already configured against it. The old address stays live so a
    rename is never a breaking change for something already pointed at it.
  */
  "routes": [{ "pattern": "api-myx.samchitech.com", "custom_domain": true }],
  "workers_dev": true,
  // Transactional email in production goes through Resend over HTTPS — its free
  // tier needs no paid plan, whereas Cloudflare Email Sending requires Workers
  // Paid ($5/mo). Set the key with `wrangler secret put RESEND_API_KEY`.
  //
  // This binding stays because `wrangler dev` simulates it, which is what makes
  // the signup and reset flows testable locally with no key and no real mail.
  // See src/lib/email.ts for the transport order.
  "send_email": [{ "name": "EMAIL" }],

  // Flood protection for /api/*. Free, and unlike the D1 limiter it costs no
  // database writes — see src/lib/apilimit.ts for why both exist.
  "ratelimits": [
    {
      "name": "API_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "myx-db",
      "database_id": "ab5a4c50-4c48-41b6-ae3e-02ce46b63b82",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Non-secret defaults. JWT_SECRET is set via `wrangler secret put JWT_SECRET`
    // for production and via .dev.vars for local dev.
    "APP_NAME": "MyX",
    // Public signups are open. Set to anything else to close registration to
    // everyone except the very first account (see routes/auth.ts).
    "REGISTRATION_OPEN": "true",
    "APP_URL": "https://myx.samchitech.com",
    "EMAIL_FROM": "noreply@samchitech.com",
    // Enforced on the data routes, not on login — see middleware.ts. Sign-in and
    // /api/auth/* stay open so an unverified account can still enter its code.
    "REQUIRE_VERIFIED_EMAIL": "true"
  }
}

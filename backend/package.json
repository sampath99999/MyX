{
  "name": "myx-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply myx-db --local",
    "db:migrate": "wrangler d1 migrations apply myx-db --remote",
    "cf-typegen": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250109.0",
    "@types/node": "^26.2.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.107.0"
  },
  "allowScripts": {
    "workerd@1.20260701.1": true
  }
}
